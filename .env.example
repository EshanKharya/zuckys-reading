# ==========================================
# Zucky's Reading - Runtime Configuration
# ==========================================

# Application Release Version
APP_VERSION=v1.0

# Path to the raw WhatsApp chat export (.txt)
CHAT_EXPORT_PATH=chats/WhatsApp Chat with BTC sher 🦁.txt

# Subsystem Toggles
ENABLE_STATIC_ANALYSIS=true
ENABLE_SEMANTIC_ANALYSIS=false

# LLM Configuration (Release v2.0)
LLM_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_TEMPERATURE=0.7
MODEL_CONTEXT_WINDOW=8192

